# Database
DATABASE_URL="postgresql://logistics:logistics_dev@localhost:5433/logistics?schema=public"

# Auth
# Required, minimum 32 characters, and the two must differ.
# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=""
JWT_REFRESH_SECRET=""
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="7d"

# Server
PORT=3000
NODE_ENV=development
WEB_ORIGIN="http://localhost:5173"
COOKIE_SECURE=false

# Snapshots
SNAPSHOT_DIR="./data/snapshots"
SNAPSHOT_RETENTION_DAILY=30
SNAPSHOT_CRON="0 18 * * *"
SNAPSHOT_TZ="Asia/Jerusalem"

# Slack (leave the token empty to disable sending; snapshots still stored). Each battalion's own channels are
# set in the app (מערכת ← Slack, platform admin). The three legacy channel ids below are read once at boot to give
# גדוד 8239 the channels it already had; they are not needed for any other battalion.
SLACK_BOT_TOKEN=""
SLACK_CHANNEL_ID=""
MESAKEM_SLACK_CHANNEL_ID=""
ATTENDANCE_SLACK_CHANNEL_ID=""
# The full-database dump: a PRIVATE platform channel (never a battalion's). Unset = the dump is kept on disk only.
DB_BACKUP_SLACK_CHANNEL_ID=""

# Test-only: skips rate limiting. Env validation rejects this in production.
DISABLE_RATE_LIMIT=false
