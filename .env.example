# Database
DATABASE_URL="postgresql://logistics:logistics_dev@localhost:5433/logistics?schema=public"

# Auth
JWT_ACCESS_SECRET="change-me-in-production"
JWT_REFRESH_SECRET="change-me-too-in-production"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="7d"

# Server
PORT=3000
NODE_ENV=development
WEB_ORIGIN="http://localhost:5173"
COOKIE_SECURE=false

# Snapshots
SNAPSHOT_DIR="./data/snapshots"
SNAPSHOT_RETENTION_DAILY=30
SNAPSHOT_CRON="0 18 * * *"
SNAPSHOT_TZ="Asia/Jerusalem"

# Slack (leave empty to disable sending; snapshots still stored)
SLACK_BOT_TOKEN=""
SLACK_CHANNEL_ID=""
