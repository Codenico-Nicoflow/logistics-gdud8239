generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ---------- enums ----------

enum Role {
  admin
  logistics
  viewer
  /// חיילים CRUD only — adds/removes soldiers from the roster.
  SHLISHUT     @map("שלישות")
  /// Sets the battalion-wide cap per item before a תקופת שרות.
  SAMGAD       @map("סמג\"ד")
  /// סגן מפקד פלוגה — assigns his own company's soldiers against the
  /// company's allocation, once סמג"ד has set it. Scoped by `companyScope`,
  /// same as `logistics` today. DB enum value kept as "מ\"פ" for stability;
  /// the Hebrew label shown in the app is "סגן מפקד פלוגה" (apps/web/src/i18n/he.ts).
  COMPANY_CMDR @map("מ\"פ")
}

enum PermissionLevel {
  NONE  @map("אין")
  READ  @map("צפייה")
  WRITE @map("עריכה")
}

enum Company {
  A       @map("א")
  B       @map("ב")
  C       @map("ג")
  SUPPORT @map("מסייעת")
  HQ      @map("מפקדה")
}

enum ItemCategory {
  WEAPON    @map("נשק")
  OPTICS    @map("אופטיקה")
  DRONE     @map("רחפן")
  /// Magazines, slings, cleaning kits. Signed for on the 1008 like anything
  /// else, but carries no מסד and is never counted in the nightly ספירה —
  /// which is `isSerialized: false` plus `inSummary: false`, not a rule of
  /// its own. The category exists to group them in the catalog and the form.
  ACCESSORY @map("אבזור")
  GEAR      @map("ציוד")
  AMMO      @map("תחמושת")
}

enum InstanceStatus {
  OK        @map("תקין")
  FAULTY    @map("תקול")
  DISABLED  @map("מושבת")
  /// Sent out for repair, not just marked broken in place — the physical
  /// item has left the armory, so it must drop out of בפועל the same way a
  /// held signature does, until it's marked OK again on return.
  IN_REPAIR @map("בתיקון")
}

enum MovementAction {
  ISSUE   @map("ניפוק")
  RETURN  @map("זיכוי")
  /// אפסון: the soldier leaves an item in the armory. His signature stays open.
  STORE   @map("אופסן")
  /// He takes it back out of the armory.
  COLLECT @map("נלקח מאפסון")
}

enum IfsunStatus {
  STORED    @map("מאופסן")
  COLLECTED @map("נלקח")
  /// He never came back for it: the signature was credited and the item is the armory's again.
  CREDITED  @map("זוכה")
}

enum CountShift {
  EVENING @map("ערב")
  MORNING @map("בוקר")
}

enum AttendanceStatus {
  PRESENT      @map("נוכח")
  LEAVING      @map("יציאה")
  RETURNING    @map("חזרה")
  ON_LEAVE     @map("חופש")
  GIMELIM      @map("גימלים")
  CLOSED_ORDER @map("צו סגור")
  OTHER        @map("אחר")
}

enum Gender {
  M @map("ז")
  F @map("נ")
}

enum IssueKind {
  MISSING_SERIAL       @map("חסר מסד")
  DUPLICATE_SERIAL     @map("מסד כפול")
  UNKNOWN_ITEM         @map("פריט לא מזוהה")
  UNKNOWN_COMPANY      @map("פלוגה לא מזוהה")
  MISSING_SOLDIER_NAME @map("חסר שם חייל")
  DUPLICATE_ROW        @map("שורה כפולה")
}

enum SnapshotKind {
  daily
  pre_import @map("pre-import")
  manual
}

/// Separate from SnapshotKind: a Snapshot is the human-readable xlsx export
/// of the signature/catalog data, re-importable through the excel module. A
/// DbBackup is a raw `pg_dump` of the entire database — every table, not
/// just the ones the xlsx exporter knows about — kept purely for disaster
/// recovery, never read back into the app directly.
enum DbBackupKind {
  daily
  manual
}

// ---------- auth ----------

model User {
  id                String    @id @default(uuid())
  username          String    @unique
  /// Null until a new user opens his invite link and chooses his own password: nobody else ever
  /// knows or sets it, and a user without one cannot log in.
  passwordHash      String?   @map("password_hash")
  displayName       String    @map("display_name")
  role              Role
  companyScope      Company?  @map("company_scope")
  isActive          Boolean   @default(true) @map("is_active")
  createdAt         DateTime  @default(now()) @map("created_at")
  /// A single top-level admin above the regular `admin` role — can edit or
  /// deactivate any user including other admins. A regular admin cannot
  /// touch a super-admin's account or grant this flag to anyone; only
  /// a super-admin can. Role stays `admin` either way, so every existing
  /// `admin`-scoped guard and permission check keeps working unchanged —
  /// this only widens what a super-admin may additionally do in users.service.
  isSuperAdmin      Boolean   @default(false) @map("is_super_admin")
  /// Consecutive wrong passwords. Past a threshold the account is locked for a growing
  /// time (`lockedUntil`), counted per ACCOUNT rather than per IP so an attack spread over
  /// many addresses is still stopped. Reset on a successful login.
  failedLoginCount  Int       @default(0) @map("failed_login_count")
  lockedUntil       DateTime? @map("locked_until")
  /// Access tokens issued before this instant are refused, so changing or resetting a
  /// password ends other sessions now, not when their 15-minute token runs out.
  passwordChangedAt DateTime? @map("password_changed_at")
  lastLoginAt       DateTime? @map("last_login_at")
  /// True from the moment an admin issues a setup link (new user, or a forgotten password / lost
  /// device) until it is used. While set, the account cannot log in.
  mustSetup         Boolean   @default(false) @map("must_setup")
  /// A super-admin has excused this person from the authenticator step (even while it is required for everyone else).
  mfaExempt         Boolean   @default(false) @map("mfa_exempt")

  refreshTokens       RefreshToken[]
  invites             UserInvite[]         @relation("inviteFor")
  invitesCreated      UserInvite[]         @relation("inviteBy")
  securityEvents      SecurityEvent[]      @relation("eventFor")
  totp                UserTotp?
  importLogs          ImportLog[]
  signaturesIssued    Signature[]          @relation("signedBy")
  signaturesReturned  Signature[]          @relation("returnedBy")
  movements           Movement[]
  countSessions       CountSession[]
  snapshots           Snapshot[]
  dbBackups           DbBackup[]
  issueForms          IssueForm[]
  issueFormAmendments IssueFormAmendment[]
  dailySummaryLines   DailySummaryLine[]
  countReopens        CountSessionReopen[]

  @@map("users")
}

/// One row per active login session. Stored hashed so a database leak cannot be
/// replayed as a session, and revocable so logout and account lockout take
/// effect immediately rather than when the token expires.
model RefreshToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  createdAt DateTime  @default(now()) @map("created_at")
  revokedAt DateTime? @map("revoked_at")
  userAgent String?   @map("user_agent")
  ip        String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

// ---------- people ----------

model Soldier {
  id             String   @id @default(uuid())
  firstName      String   @map("first_name")
  lastName       String   @map("last_name")
  personalNumber String?  @unique @map("personal_number")
  phone          String?
  company        Company
  receiptNo      String?  @map("receipt_no")
  notes          String?
  /// מסופח — attached from another unit rather than organic to the battalion.
  isAttached     Boolean  @default(false) @map("is_attached")
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  signatures  Signature[]
  movements   Movement[]
  issueForms  IssueForm[]
  enlistments SoldierEnlistment[]
  allocations SoldierAllocation[]

  @@index([lastName, firstName])
  @@index([company])
  @@map("soldiers")
}

/// מחויל — שלישות marks a soldier enlisted for a specific תקופת שרות. Resets
/// every stint: being enlisted last taasuka says nothing about this one. A
/// weapon (serialized item) cannot be issued to a soldier who isn't enlisted
/// in the currently active service period — enforced in
/// `SignaturesService.issue`.
model SoldierEnlistment {
  id              String   @id @default(uuid())
  soldierId       String   @map("soldier_id")
  servicePeriodId String   @map("service_period_id")
  createdAt       DateTime @default(now()) @map("created_at")

  soldier       Soldier       @relation(fields: [soldierId], references: [id], onDelete: Cascade)
  servicePeriod ServicePeriod @relation(fields: [servicePeriodId], references: [id], onDelete: Cascade)

  @@unique([soldierId, servicePeriodId])
  @@map("soldier_enlistments")
}

model TeamMember {
  id             String   @id @default(uuid())
  nickname       String   @unique
  fullName       String?  @map("full_name")
  personalNumber String?  @map("personal_number")
  gender         Gender   @default(M)
  isActive       Boolean  @default(true) @map("is_active")
  sortOrder      Int      @default(0) @map("sort_order")
  createdAt      DateTime @default(now()) @map("created_at")

  attendance Attendance[]

  @@map("team_members")
}

// ---------- catalog ----------

model Item {
  id            String       @id @default(uuid())
  name          String       @unique
  aliases       String[]     @default([])
  category      ItemCategory
  isSerialized  Boolean      @default(true) @map("is_serialized")
  /// Whether the item appears in מסכם and in the ספירת נשקיה sheet derived from
  /// it. The catalog holds items nobody tracks daily (priced gear, zero-stock
  /// spares); listing them all would make the evening count unusable.
  inSummary     Boolean      @default(true) @map("in_summary")
  authorizedQty Int          @default(0) @map("authorized_qty")
  /// Count of units physically sitting in ימ״ח, out of authorizedQty. A plain
  /// admin-typed number, not tied to specific מסדים — too hard to keep which
  /// serial is where in sync, so only the total is tracked. בפועל (on-hand)
  /// is derived in the UI as authorizedQty - yamahQty - repairQty, never stored.
  yamahQty      Int          @default(0) @map("yamah_qty")
  /// Same idea as yamahQty but for bulk (non-serialized) items sent out for
  /// repair — a plain admin-typed count, since there's no individual מסד to
  /// flag IN_REPAIR the way a serialized item's ItemInstance can be.
  repairQty     Int          @default(0) @map("repair_qty")
  /// Which units of a bulk item are in repair: their מסדים, at most `repairQty` of them (some units may
  /// have none). Serialized items do not use this: their repair list is the instances marked IN_REPAIR.
  repairSerials String[]     @default([]) @map("repair_serials")
  /// Pre-filled on the issue form — five מחסניות, one רצועה. The operator can
  /// change it, including to zero, which drops the line from the form.
  defaultQty    Int          @default(1) @map("default_qty")
  /// `י"ח` on the 1008 — the unit the quantity is counted in. Almost always
  /// יח', but the paper form has the column so some items are not.
  unitOfMeasure String       @default("יח'") @map("unit_of_measure")
  unitPrice     Decimal?     @map("unit_price") @db.Decimal(10, 2)
  isActive      Boolean      @default(true) @map("is_active")
  createdAt     DateTime     @default(now()) @map("created_at")

  instances          ItemInstance[]
  signatures         Signature[]
  countLines         CountLine[]
  countFigures       CountSessionFigure[]
  dailySummaryLines  DailySummaryLine[]
  movements          Movement[]
  formLines          IssueFormLine[]
  companyAllocations CompanyAllocation[]
  onHandOverrides    ServicePeriodItemOverride[]
  soldierAllocations SoldierAllocation[]
  /// The kit this item is the base of, and every kit it appears in as a line.
  kit                ItemKit?
  kitLines           ItemKitLine[]

  @@map("items")
}

/// What always rides along into the 1008 basket when `baseItem` is issued (M-4 → 5 מחסניות, מק פורק, רצועה,
/// 3 מתפסים) — edited by an admin on the ערכות screen. Optics and the like are NOT kit: a soldier gets those
/// through his own allocation. Replaces the rules that used to be hardcoded in `issue-bundle-rules.ts`.
model ItemKit {
  id         String   @id @default(uuid())
  baseItemId String   @unique @map("base_item_id")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  baseItem Item          @relation(fields: [baseItemId], references: [id], onDelete: Cascade)
  lines    ItemKitLine[]

  @@map("item_kits")
}

model ItemKitLine {
  id       String @id @default(uuid())
  kitId    String @map("kit_id")
  itemId   String @map("item_id")
  quantity Int
  position Int

  kit  ItemKit @relation(fields: [kitId], references: [id], onDelete: Cascade)
  /// Restrict: an item that is still in a kit cannot be deleted from under it.
  item Item    @relation(fields: [itemId], references: [id], onDelete: Restrict)

  @@unique([kitId, itemId])
  @@index([itemId])
  @@map("item_kit_lines")
}

/// Append-only history of kit edits (DB trigger, like movements). Holds names, not foreign keys, so
/// the history stays readable after an item or a user is gone.
model ItemKitChange {
  id           String   @id @default(uuid())
  at           DateTime @default(now())
  baseItemId   String   @map("base_item_id")
  baseItemName String   @map("base_item_name")
  actorName    String   @map("actor_name")
  /// `[{ itemName, quantity }]` before and after the save.
  before       Json
  after        Json

  @@index([baseItemId, at])
  @@map("item_kit_changes")
}

model ItemInstance {
  id        String         @id @default(uuid())
  itemId    String         @map("item_id")
  serial    String
  status    InstanceStatus @default(OK)
  notes     String?
  createdAt DateTime       @default(now()) @map("created_at")

  item       Item        @relation(fields: [itemId], references: [id], onDelete: Cascade)
  signatures Signature[]

  @@unique([itemId, serial])
  @@index([serial])
  @@map("item_instances")
}

// ---------- the core ----------

model Signature {
  id               String    @id @default(uuid())
  soldierId        String    @map("soldier_id")
  itemId           String    @map("item_id")
  itemInstanceId   String?   @map("item_instance_id")
  quantity         Int       @default(1)
  receiptNo        String?   @map("receipt_no")
  notes            String?
  signedAt         DateTime  @default(now()) @map("signed_at")
  signedByUserId   String    @map("signed_by_user_id")
  returnedAt       DateTime? @map("returned_at")
  returnedByUserId String?   @map("returned_by_user_id")
  // Set when the row was imported with a known data problem (e.g. a serialized
  // item with no serial). Drives the "דרוש טיפול" tab. New signatures created in
  // the app are always clean: the API refuses a serialized item without a serial.
  needsAttention   Boolean   @default(false) @map("needs_attention")

  soldier      Soldier       @relation(fields: [soldierId], references: [id], onDelete: Restrict)
  item         Item          @relation(fields: [itemId], references: [id])
  itemInstance ItemInstance? @relation(fields: [itemInstanceId], references: [id])
  signedBy     User          @relation("signedBy", fields: [signedByUserId], references: [id])
  returnedBy   User?         @relation("returnedBy", fields: [returnedByUserId], references: [id])
  ifsunRecords IfsunRecord[]

  @@index([soldierId])
  @@index([itemId])
  @@index([returnedAt])
  @@index([needsAttention])
  @@map("signatures")
}

/// `טופס 1008` — one signing event covering everything a soldier received at
/// once: a weapon with its מסד alongside the magazines, sling and cleaning kit
/// that go with it.
///
/// The soldier's drawn signature is captured on the device at the counter and
/// stored here, so the form can be reproduced exactly as it was agreed to.
/// Every detail is snapshotted rather than joined: the form is evidence of
/// what was signed on a date, and must not change because a soldier later
/// moved company or an item was renamed.
model IssueForm {
  id        String @id @default(uuid())
  /// Sequential, human-quotable form number. Printed on the PDF.
  formNo    Int    @unique @default(autoincrement()) @map("form_no")
  soldierId String @map("soldier_id")

  /// `פרטי החייל השואל` — the borrower, as they were when they signed.
  soldierNameSnapshot    String  @map("soldier_name_snapshot")
  personalNumberSnapshot String? @map("personal_number_snapshot")
  companySnapshot        Company @map("company_snapshot")
  phoneSnapshot          String? @map("phone_snapshot")

  /// `מס קבלה` in the header box of the paper form.
  receiptNo String? @map("receipt_no")

  /// PNG data URL of the borrower's signature, drawn on the device.
  signatureImage String   @map("signature_image")
  signedAt       DateTime @default(now()) @map("signed_at")

  /// `פרטי החייל המשאיל` — the issuer. Their own signature is drawn too, so
  /// the printed form carries both halves the paper one has.
  issuedByUserId       String  @map("issued_by_user_id")
  issuedByNameSnapshot String  @map("issued_by_name_snapshot")
  issuerPersonalNumber String? @map("issuer_personal_number")
  issuerSignatureImage String? @map("issuer_signature_image")

  notes String?

  soldier    Soldier              @relation(fields: [soldierId], references: [id], onDelete: Restrict)
  issuedBy   User                 @relation(fields: [issuedByUserId], references: [id])
  lines      IssueFormLine[]
  amendments IssueFormAmendment[]

  @@index([soldierId])
  @@index([signedAt])
  @@map("issue_forms")
}

/// One line of a 1008: an item, how many, and its מסד when it has one.
model IssueFormLine {
  id               String  @id @default(uuid())
  issueFormId      String  @map("issue_form_id")
  itemId           String  @map("item_id")
  /// Snapshotted for the same reason as the soldier's name.
  itemNameSnapshot String  @map("item_name_snapshot")
  /// `מזהה` on the paper form: the weapon's serial, known as מסד or צ׳.
  serialSnapshot   String? @map("serial_snapshot")
  /// `י"ח` — the unit the quantity is counted in, as it was when signed.
  unitOfMeasure    String  @default("יח'") @map("unit_of_measure")
  quantity         Int     @default(1)
  /// `הערות` — the per-line note column the paper form has.
  lineNotes        String? @map("line_notes")
  /// The signature this line created, so a return can be traced back to the
  /// form it was issued on. Not a foreign key: an Excel import replaces every
  /// signature, and a signed form must outlive that.
  signatureId      String? @map("signature_id")

  issueForm IssueForm @relation(fields: [issueFormId], references: [id], onDelete: Cascade)
  item      Item      @relation(fields: [itemId], references: [id])

  @@index([issueFormId])
  @@map("issue_form_lines")
}

/// A clerical correction to a signed 1008's header — מס קבלה / הערות only,
/// never the lines, soldier, issuer, or either signature image: those are
/// what was actually signed, and `issue_forms` itself stays append-only
/// (DB trigger, see IssueForm) because of it. An edit here is a new row, not
/// an UPDATE, for the same reason — the form's true history (who corrected
/// what, and when) stays intact rather than being overwritten. The
/// *effective* value shown anywhere (the screen, the printed form) is the
/// latest amendment for that form, falling back to `IssueForm`'s own
/// original field when none exists yet.
model IssueFormAmendment {
  id              String   @id @default(uuid())
  issueFormId     String   @map("issue_form_id")
  receiptNo       String?  @map("receipt_no")
  notes           String?
  amendedByUserId String   @map("amended_by_user_id")
  amendedAt       DateTime @default(now()) @map("amended_at")

  issueForm IssueForm @relation(fields: [issueFormId], references: [id], onDelete: Cascade)
  amendedBy User      @relation(fields: [amendedByUserId], references: [id])

  @@index([issueFormId, amendedAt])
  @@map("issue_form_amendments")
}

// Append-only audit log. No update/delete route exists for this table.
model Movement {
  id                      String         @id @default(uuid())
  action                  MovementAction
  soldierId               String?        @map("soldier_id")
  soldierNameSnapshot     String         @map("soldier_name_snapshot")
  companySnapshot         Company?       @map("company_snapshot")
  itemId                  String?        @map("item_id")
  itemNameSnapshot        String         @map("item_name_snapshot")
  serialSnapshot          String?        @map("serial_snapshot")
  quantity                Int            @default(1)
  receiptNo               String?        @map("receipt_no")
  occurredAt              DateTime       @default(now()) @map("occurred_at")
  performedByUserId       String?        @map("performed_by_user_id")
  performedByNameSnapshot String         @map("performed_by_name_snapshot")
  notes                   String?
  // Loose reference, deliberately not a foreign key: the Excel import replaces all
  // signature rows, and append-only audit rows must never be rewritten to follow.
  signatureId             String?        @map("signature_id")

  soldier     Soldier? @relation(fields: [soldierId], references: [id], onDelete: Restrict)
  item        Item?    @relation(fields: [itemId], references: [id], onDelete: Restrict)
  performedBy User?    @relation(fields: [performedByUserId], references: [id], onDelete: Restrict)

  @@index([occurredAt])
  @@index([action])
  @@index([soldierId])
  @@index([itemId])
  @@map("movements")
}

// ---------- manual inputs ----------

// ---------- תקופת שרות (reserve-duty call-ups) ----------

enum ServicePeriodStatus {
  PLANNING @map("תכנון")
  ACTIVE   @map("פעילה")
  CLOSED   @map("סגורה")
}

/// One stretch of reserve duty — e.g. "מרץ 2027". Allocations are scoped to a
/// period so last cycle's assignments never bleed into the next one.
model ServicePeriod {
  id        String              @id @default(uuid())
  name      String
  startsAt  DateTime            @map("starts_at") @db.Date
  endsAt    DateTime            @map("ends_at") @db.Date
  status    ServicePeriodStatus @default(PLANNING)
  createdAt DateTime            @default(now()) @map("created_at")

  companyAllocations CompanyAllocation[]
  enlistments        SoldierEnlistment[]
  onHandOverrides    ServicePeriodItemOverride[]
  soldierAllocations SoldierAllocation[]

  @@map("service_periods")
}

/// The samgad's per-company split for a תקופת שרות — "פלוגה א מקבלת 82 M-4".
/// Capped against the item's בפועל (authorizedQty − yamahQty): the sum across
/// all five companies for one item can never exceed what is physically on
/// hand, enforced in `AllocationsService.setCompanyAllocation`.
model CompanyAllocation {
  id              String  @id @default(uuid())
  servicePeriodId String  @map("service_period_id")
  itemId          String  @map("item_id")
  company         Company
  quantity        Int     @default(0)

  servicePeriod ServicePeriod @relation(fields: [servicePeriodId], references: [id], onDelete: Cascade)
  item          Item          @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([servicePeriodId, itemId, company])
  @@map("company_allocations")
}

/// Admin-only, per-period override of an item's בפועל for allocation purposes —
/// e.g. the catalog says 29 on hand but the admin wants the samgad planning
/// against only 25 this time (some are reserved, held back, whatever), without
/// changing the real authorizedQty/yamahQty the rest of the app relies on.
/// Never exceeds the item's real בפועל — enforced in
/// `AllocationsService.setOnHandOverride`. Absent means "use the real בפועל".
model ServicePeriodItemOverride {
  id              String @id @default(uuid())
  servicePeriodId String @map("service_period_id")
  itemId          String @map("item_id")
  onHand          Int    @map("on_hand")

  servicePeriod ServicePeriod @relation(fields: [servicePeriodId], references: [id], onDelete: Cascade)
  item          Item          @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([servicePeriodId, itemId])
  @@map("service_period_item_overrides")
}

/// A company commander's (סגן מפקד פלוגה) planning breakdown of his company's
/// share — "מאג מ-4 למטולון, מכפל, מפרו" — never exceeding what the samgad
/// gave that company for the item (`CompanyAllocation.quantity`), enforced in
/// `AllocationsService.setSoldierAllocation`. Planning only: it does not
/// constrain what an actual 1008 can issue, unlike the בפועל cap on
/// `CompanyAllocation` itself — see CLAUDE.md.
model SoldierAllocation {
  id              String @id @default(uuid())
  servicePeriodId String @map("service_period_id")
  itemId          String @map("item_id")
  soldierId       String @map("soldier_id")
  quantity        Int    @default(0)

  servicePeriod ServicePeriod @relation(fields: [servicePeriodId], references: [id], onDelete: Cascade)
  item          Item          @relation(fields: [itemId], references: [id], onDelete: Cascade)
  soldier       Soldier       @relation(fields: [soldierId], references: [id], onDelete: Cascade)

  @@unique([servicePeriodId, itemId, soldierId])
  @@map("soldier_allocations_v2")
}

model CountSession {
  id                        String     @id @default(uuid())
  sessionDate               DateTime   @map("session_date") @db.Date
  shift                     CountShift
  responsibleName           String?    @map("responsible_name")
  responsiblePn             String?    @map("responsible_pn")
  responsibleRank           String?    @map("responsible_rank")
  officerName               String?    @map("officer_name")
  officerPn                 String?    @map("officer_pn")
  officerRank               String?    @map("officer_rank")
  /// Drawn on the device, same as a 1008's. Nullable because the paper flow
  /// allows printing before the second signer is physically present — they
  /// sign the printed sheet by hand instead.
  responsibleSignatureImage String?    @map("responsible_signature_image")
  officerSignatureImage     String?    @map("officer_signature_image")
  recordedAt                DateTime   @default(now()) @map("recorded_at")
  recordedByUserId          String     @map("recorded_by_user_id")
  isClosed                  Boolean    @default(false) @map("is_closed")

  recordedBy User                 @relation(fields: [recordedByUserId], references: [id])
  lines      CountLine[]
  figures    CountSessionFigure[]
  reopens    CountSessionReopen[]

  @@unique([sessionDate, shift])
  @@map("count_sessions")
}

/// What a closed count actually signed. A count verifies the מסכם figure, and
/// that figure can be corrected later (an emergency issue at 19:30); without
/// this the printout of a signed sheet would silently change with it. Written
/// when the count closes, dropped when it is reopened.
model CountSessionFigure {
  id             String       @id @default(uuid())
  countSessionId String       @map("count_session_id")
  itemId         String       @map("item_id")
  itemName       String       @map("item_name")
  category       ItemCategory
  nashkiyaQty    Int?         @map("nashkiya_qty")

  countSession CountSession @relation(fields: [countSessionId], references: [id], onDelete: Cascade)
  item         Item         @relation(fields: [itemId], references: [id])

  @@unique([countSessionId, itemId])
  @@map("count_session_figures")
}

model CountLine {
  id             String  @id @default(uuid())
  countSessionId String  @map("count_session_id")
  itemId         String  @map("item_id")
  countedQty     Int     @default(0) @map("counted_qty")
  faultyQty      Int     @default(0) @map("faulty_qty")
  notes          String?

  countSession CountSession @relation(fields: [countSessionId], references: [id], onDelete: Cascade)
  item         Item         @relation(fields: [itemId], references: [id])

  @@unique([countSessionId, itemId])
  @@map("count_lines")
}

/// An admin cancelling a closed ספירה — the mistake path. Closing is a signed,
/// final-looking act, so undoing it leaves a record of who, when and why,
/// even though the signatures themselves are cleared and must be redone.
model CountSessionReopen {
  id               String   @id @default(uuid())
  countSessionId   String   @map("count_session_id")
  reopenedByUserId String   @map("reopened_by_user_id")
  reason           String
  reopenedAt       DateTime @default(now()) @map("reopened_at")

  countSession CountSession @relation(fields: [countSessionId], references: [id], onDelete: Cascade)
  reopenedBy   User         @relation(fields: [reopenedByUserId], references: [id])

  @@index([countSessionId])
  @@map("count_session_reopens")
}

/// `מסכם` — the once-a-day armory headcount entered by hand (`בבקשה`/`בנשקייה`
/// on the old sheet), one value per item per calendar day, no morning/evening
/// split the way `CountSession` has. `ספירת נשקיה` then reads this same value
/// back as the figure the two signers verify together — one number is typed
/// once here, never re-typed there.
model DailySummaryLine {
  id              String   @id @default(uuid())
  sessionDate     DateTime @map("session_date") @db.Date
  itemId          String   @map("item_id")
  nashkiyaQty     Int      @map("nashkiya_qty")
  updatedAt       DateTime @updatedAt @map("updated_at")
  updatedByUserId String   @map("updated_by_user_id")

  item      Item @relation(fields: [itemId], references: [id])
  updatedBy User @relation(fields: [updatedByUserId], references: [id])

  @@unique([sessionDate, itemId])
  @@map("daily_summary_lines")
}

/// One row per day once "סיים יום" is pressed — tracks whether that day's
/// מסכם Excel made it to Slack, same shape as `DbBackup`'s own
/// `slackSentAt`/`slackError` pair, so a failed send is visible and retriable
/// instead of silently lost.
model DailySummaryExport {
  id          String    @id @default(uuid())
  sessionDate DateTime  @unique @map("session_date") @db.Date
  createdAt   DateTime  @default(now()) @map("created_at")
  slackSentAt DateTime? @map("slack_sent_at")
  slackError  String?   @map("slack_error")

  @@map("daily_summary_exports")
}

model Attendance {
  id           String           @id @default(uuid())
  teamMemberId String           @map("team_member_id")
  date         DateTime         @db.Date
  status       AttendanceStatus
  note         String?

  teamMember TeamMember @relation(fields: [teamMemberId], references: [id], onDelete: Cascade)

  @@unique([teamMemberId, date])
  @@index([date])
  @@map("attendance")
}

/// One row per data problem found during an Excel import. Everything is imported;
/// these rows are what the "דרוש טיפול" tab lists so the gaps get fixed by hand.
model ImportIssue {
  id          String    @id @default(uuid())
  kind        IssueKind
  rowNumber   Int       @map("row_number")
  rawRow      String    @map("raw_row")
  detail      String
  signatureId String?   @map("signature_id")
  soldierId   String?   @map("soldier_id")
  itemId      String?   @map("item_id")
  serial      String?
  resolvedAt  DateTime? @map("resolved_at")
  importedAt  DateTime  @default(now()) @map("imported_at")

  @@index([kind])
  @@index([resolvedAt])
  @@map("import_issues")
}

/// Excel imports, kept out of `movements` so דוח תנועות contains only the two
/// real actions: giving an item to a soldier and taking it back.
model ImportLog {
  id                      String   @id @default(uuid())
  occurredAt              DateTime @default(now()) @map("occurred_at")
  fileName                String?  @map("file_name")
  totalRows               Int      @map("total_rows")
  signatures              Int
  soldiers                Int
  flagged                 Int
  issues                  Int
  snapshotId              String?  @map("snapshot_id")
  performedByUserId       String?  @map("performed_by_user_id")
  performedByNameSnapshot String   @map("performed_by_name_snapshot")
  notes                   String?

  performedBy User? @relation(fields: [performedByUserId], references: [id], onDelete: Restrict)

  @@index([occurredAt])
  @@map("import_logs")
}

model Snapshot {
  id              String       @id @default(uuid())
  createdAt       DateTime     @default(now()) @map("created_at")
  kind            SnapshotKind
  filePath        String       @map("file_path")
  sizeBytes       Int          @map("size_bytes")
  rowCount        Int          @default(0) @map("row_count")
  slackSentAt     DateTime?    @map("slack_sent_at")
  slackError      String?      @map("slack_error")
  createdByUserId String?      @map("created_by_user_id")

  createdBy User? @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@map("snapshots")
}

model DbBackup {
  id              String       @id @default(uuid())
  createdAt       DateTime     @default(now()) @map("created_at")
  kind            DbBackupKind
  filePath        String       @map("file_path")
  sizeBytes       Int          @map("size_bytes")
  slackSentAt     DateTime?    @map("slack_sent_at")
  slackError      String?      @map("slack_error")
  createdByUserId String?      @map("created_by_user_id")

  createdBy User? @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@map("db_backups")
}

// ---------- permissions ----------

/// What each role can do, per screen — editable from the admin הרשאות screen
/// rather than fixed in code, so e.g. giving סמג"ד read access to חתימות
/// tomorrow is a toggle, not a deploy.
///
/// `admin` is not represented here: it always has WRITE on everything,
/// hardcoded, so the matrix can never lock every account out of the app.
model RolePermission {
  id    String          @id @default(uuid())
  role  Role
  /// A screen/feature key, e.g. "soldiers", "allocations.battalion",
  /// "signatures", "issue", "catalog".
  key   String
  level PermissionLevel @default(NONE)

  @@unique([role, key])
  @@map("role_permissions")
}

/// Deleting a count is the one thing that erases a signed record, so it leaves
/// this row behind. No relation to the session on purpose: it must outlive it.
model CountSessionDeletion {
  id              String     @id @default(uuid())
  sessionDate     DateTime   @map("session_date") @db.Date
  shift           CountShift
  responsibleName String?    @map("responsible_name")
  officerName     String?    @map("officer_name")
  deletedByName   String     @map("deleted_by_name")
  reason          String
  deletedAt       DateTime   @default(now()) @map("deleted_at")

  @@map("count_session_deletions")
}

/// אפסון — a soldier leaves an item in the armory instead of taking it home.
///
/// The signature stays open (it is still his), but the item is physically on
/// the shelf, so the nightly ספירה and the מסכם must count it as present and
/// not as "out with a soldier". That is the whole reason this is a table of its
/// own rather than a flag on the signature: a soldier can store and collect the
/// same weapon many times, and each stint is history worth keeping.
///
/// Names and serial are snapshotted, like movements, so the record still reads
/// correctly after a soldier or item is renamed.
model IfsunRecord {
  id                  String      @id @default(uuid())
  signatureId         String      @map("signature_id")
  soldierId           String      @map("soldier_id")
  soldierNameSnapshot String      @map("soldier_name_snapshot")
  companySnapshot     Company?    @map("company_snapshot")
  itemId              String      @map("item_id")
  itemNameSnapshot    String      @map("item_name_snapshot")
  serialSnapshot      String?     @map("serial_snapshot")
  quantity            Int         @default(1)
  status              IfsunStatus @default(STORED)
  notes               String?
  storedAt            DateTime    @default(now()) @map("stored_at")
  storedByUserId      String      @map("stored_by_user_id")
  storedByName        String      @map("stored_by_name")
  closedAt            DateTime?   @map("closed_at")
  closedByName        String?     @map("closed_by_name")
  closeNotes          String?     @map("close_notes")

  /// The two signed halves of the אפסון document, drawn on the device as PNG
  /// data URLs like the 1008's. Whoever hands the item in signs at deposit;
  /// whoever takes it out signs at collection — the soldier, or someone
  /// collecting for him, whose name is then recorded. Written once, never edited.
  storeSignatureImage   String? @map("store_signature_image")
  storeSignerName       String? @map("store_signer_name")
  collectSignatureImage String? @map("collect_signature_image")
  collectSignerName     String? @map("collect_signer_name")

  signature Signature @relation(fields: [signatureId], references: [id], onDelete: Restrict)

  @@index([status])
  @@index([signatureId])
  @@index([soldierId])
  @@map("ifsun_records")
}

/// One row per ימי יציאה week posted to Slack, by hand or by the Thursday job.
///
/// `cronKey` is the week's start date for the scheduled send only and is unique, so
/// when two API instances overlap during a deploy at 15:00 only one can claim the
/// week — the other's insert fails and it stays quiet. Manual sends leave it null.
model AttendanceWeekSend {
  id        String   @id @default(uuid())
  weekStart DateTime @map("week_start") @db.Date
  sentAt    DateTime @default(now()) @map("sent_at")
  trigger   String
  sentBy    String?  @map("sent_by")
  cronKey   String?  @unique @map("cron_key")
  error     String?

  @@index([weekStart])
  @@map("attendance_week_sends")
}

/// A one-time link an admin hands to a person so THEY choose their password. Only the SHA-256 of the
/// token is stored; the token itself exists once, in the link shown to the admin. `kind` is INVITE
/// (a new account) or RESET (a forgotten password / lost device).
model UserInvite {
  id              String    @id @default(uuid())
  userId          String    @map("user_id")
  tokenHash       String    @unique @map("token_hash")
  kind            String
  expiresAt       DateTime  @map("expires_at")
  usedAt          DateTime? @map("used_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  createdByUserId String?   @map("created_by_user_id")

  user      User  @relation("inviteFor", fields: [userId], references: [id], onDelete: Cascade)
  createdBy User? @relation("inviteBy", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@map("user_invites")
}

/// What happened on accounts: sign-ins, failures, locks, setup links, password changes. Never holds a
/// password, token or signature. A failed login for a username that does not exist is not stored (it
/// would let anyone fill the table), only logged.
model SecurityEvent {
  id          String   @id @default(uuid())
  at          DateTime @default(now())
  type        String
  userId      String?  @map("user_id")
  actorUserId String?  @map("actor_user_id")
  ip          String?
  detail      String?

  user User? @relation("eventFor", fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, at])
  @@index([at])
  @@map("security_events")
}

/// Authenticator-app (TOTP) second step. The secret is stored ENCRYPTED with a key that is not in the
/// database, so a stolen database or backup cannot generate codes. `confirmedAt` stays null until the
/// person has proved their app shows the right code; an unconfirmed secret never counts as enrolled.
model UserTotp {
  userId      String    @id @map("user_id")
  secretEnc   String    @map("secret_enc")
  confirmedAt DateTime? @map("confirmed_at")
  /// The last 30-second step accepted, so a code (shoulder-surfed, or replayed) works only once.
  lastStep    Int       @default(0) @map("last_step")
  createdAt   DateTime  @default(now()) @map("created_at")

  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  backupCodes TotpBackupCode[]

  @@map("user_totp")
}

/// One-time recovery codes for a lost phone. Stored as a hash; shown to the person once.
model TotpBackupCode {
  id       String    @id @default(uuid())
  userId   String    @map("user_id")
  codeHash String    @map("code_hash")
  usedAt   DateTime? @map("used_at")

  totp UserTotp @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@unique([userId, codeHash])
  @@map("totp_backup_codes")
}

/// Small key/value switches an admin flips in the UI (instead of a redeploy), e.g. `mfa.enforced`.
model AppSetting {
  key             String   @id
  value           String
  updatedAt       DateTime @updatedAt @map("updated_at")
  updatedByUserId String?  @map("updated_by_user_id")

  @@map("app_settings")
}
