generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ---------- enums ----------

enum Role {
  admin
  logistics
  viewer
}

enum Company {
  A       @map("א")
  B       @map("ב")
  C       @map("ג")
  SUPPORT @map("מסייעת")
  HQ      @map("מפקדה")
}

enum ItemCategory {
  WEAPON    @map("נשק")
  OPTICS    @map("אופטיקה")
  DRONE     @map("רחפן")
  /// Magazines, slings, cleaning kits. Signed for on the 1008 like anything
  /// else, but carries no מסד and is never counted in the nightly ספירה —
  /// which is `isSerialized: false` plus `inSummary: false`, not a rule of
  /// its own. The category exists to group them in the catalog and the form.
  ACCESSORY @map("אבזור")
  GEAR      @map("ציוד")
}

enum InstanceStatus {
  OK       @map("תקין")
  FAULTY   @map("תקול")
  DISABLED @map("מושבת")
}

enum MovementAction {
  ISSUE  @map("ניפוק")
  RETURN @map("זיכוי")
}

enum CountShift {
  EVENING @map("ערב")
  MORNING @map("בוקר")
}

enum AttendanceStatus {
  PRESENT     @map("נוכח")
  LEAVING     @map("יציאה")
  RETURNING   @map("חזרה")
  ON_LEAVE    @map("חופש")
  GIMELIM     @map("גימלים")
  CLOSED_ORDER @map("צו סגור")
  OTHER       @map("אחר")
}

enum Gender {
  M @map("ז")
  F @map("נ")
}

enum IssueKind {
  MISSING_SERIAL      @map("חסר מסד")
  DUPLICATE_SERIAL    @map("מסד כפול")
  UNKNOWN_ITEM        @map("פריט לא מזוהה")
  UNKNOWN_COMPANY     @map("פלוגה לא מזוהה")
  MISSING_SOLDIER_NAME @map("חסר שם חייל")
  DUPLICATE_ROW       @map("שורה כפולה")
}

enum SnapshotKind {
  daily
  pre_import @map("pre-import")
  manual
}

// ---------- auth ----------

model User {
  id           String   @id @default(uuid())
  username     String   @unique
  passwordHash String   @map("password_hash")
  displayName  String   @map("display_name")
  role         Role
  companyScope Company? @map("company_scope")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")

  refreshTokens      RefreshToken[]
  importLogs         ImportLog[]
  signaturesIssued   Signature[]    @relation("signedBy")
  signaturesReturned Signature[]    @relation("returnedBy")
  movements          Movement[]
  countSessions      CountSession[]
  snapshots          Snapshot[]
  issueForms         IssueForm[]

  @@map("users")
}

/// One row per active login session. Stored hashed so a database leak cannot be
/// replayed as a session, and revocable so logout and account lockout take
/// effect immediately rather than when the token expires.
model RefreshToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  createdAt DateTime  @default(now()) @map("created_at")
  revokedAt DateTime? @map("revoked_at")
  userAgent String?   @map("user_agent")
  ip        String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

// ---------- people ----------

model Soldier {
  id             String   @id @default(uuid())
  firstName      String   @map("first_name")
  lastName       String   @map("last_name")
  personalNumber String?  @unique @map("personal_number")
  phone          String?
  company        Company
  platoon        String?
  receiptNo      String?  @map("receipt_no")
  notes          String?
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  signatures Signature[]
  movements  Movement[]
  issueForms IssueForm[]

  @@index([lastName, firstName])
  @@index([company])
  @@map("soldiers")
}

model TeamMember {
  id             String   @id @default(uuid())
  nickname       String   @unique
  fullName       String?  @map("full_name")
  personalNumber String?  @map("personal_number")
  gender         Gender   @default(M)
  isActive       Boolean  @default(true) @map("is_active")
  sortOrder      Int      @default(0) @map("sort_order")
  createdAt      DateTime @default(now()) @map("created_at")

  attendance Attendance[]

  @@map("team_members")
}

// ---------- catalog ----------

model Item {
  id             String       @id @default(uuid())
  name           String       @unique
  aliases        String[]     @default([])
  category       ItemCategory
  isSerialized   Boolean      @default(true) @map("is_serialized")
  /// Whether the item appears in מסכם and in the ספירת נשקיה sheet derived from
  /// it. The catalog holds items nobody tracks daily (priced gear, zero-stock
  /// spares); listing them all would make the evening count unusable.
  inSummary      Boolean      @default(true) @map("in_summary")
  authorizedQty  Int          @default(0) @map("authorized_qty")
  /// Pre-filled on the issue form — five מחסניות, one רצועה. The operator can
  /// change it, including to zero, which drops the line from the form.
  defaultQty     Int          @default(1) @map("default_qty")
  /// `י"ח` on the 1008 — the unit the quantity is counted in. Almost always
  /// יח', but the paper form has the column so some items are not.
  unitOfMeasure  String       @default("יח'") @map("unit_of_measure")
  unitPrice      Decimal?     @map("unit_price") @db.Decimal(10, 2)
  isActive       Boolean      @default(true) @map("is_active")
  createdAt      DateTime     @default(now()) @map("created_at")

  instances   ItemInstance[]
  signatures  Signature[]
  allocations Allocation[]
  countLines  CountLine[]
  movements   Movement[]
  formLines   IssueFormLine[]
  kitLines    KitLine[]

  @@map("items")
}

model ItemInstance {
  id        String         @id @default(uuid())
  itemId    String         @map("item_id")
  serial    String
  status    InstanceStatus @default(OK)
  notes     String?
  createdAt DateTime       @default(now()) @map("created_at")

  item       Item        @relation(fields: [itemId], references: [id], onDelete: Cascade)
  signatures Signature[]

  @@unique([itemId, serial])
  @@index([serial])
  @@map("item_instances")
}

// ---------- the core ----------

model Signature {
  id             String    @id @default(uuid())
  soldierId      String    @map("soldier_id")
  itemId         String    @map("item_id")
  itemInstanceId String?   @map("item_instance_id")
  quantity       Int       @default(1)
  receiptNo      String?   @map("receipt_no")
  notes          String?
  signedAt       DateTime  @default(now()) @map("signed_at")
  signedByUserId String    @map("signed_by_user_id")
  returnedAt     DateTime? @map("returned_at")
  returnedByUserId String? @map("returned_by_user_id")
  // Set when the row was imported with a known data problem (e.g. a serialized
  // item with no serial). Drives the "דרוש טיפול" tab. New signatures created in
  // the app are always clean: the API refuses a serialized item without a serial.
  needsAttention Boolean   @default(false) @map("needs_attention")

  soldier      Soldier       @relation(fields: [soldierId], references: [id], onDelete: Restrict)
  item         Item          @relation(fields: [itemId], references: [id])
  itemInstance ItemInstance? @relation(fields: [itemInstanceId], references: [id])
  signedBy     User          @relation("signedBy", fields: [signedByUserId], references: [id])
  returnedBy   User?         @relation("returnedBy", fields: [returnedByUserId], references: [id])

  @@index([soldierId])
  @@index([itemId])
  @@index([returnedAt])
  @@index([needsAttention])
  @@map("signatures")
}

/// A standard handover: `ערכת M-4` is the rifle, five magazines, a sling and
/// a cleaning kit.
///
/// Choosing a kit fills the form's lines with their usual quantities, which
/// the operator then edits — a soldier who declines a magazine gets a form
/// that says so. The kit is a starting point, never a constraint: nothing
/// stops a line being removed or another item added alongside it.
model Kit {
  id        String   @id @default(uuid())
  name      String   @unique
  notes     String?
  isActive  Boolean  @default(true) @map("is_active")
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")

  lines KitLine[]

  @@map("kits")
}

model KitLine {
  id     String @id @default(uuid())
  kitId  String @map("kit_id")
  itemId String @map("item_id")
  /// What this kit normally includes, which may differ from the item's own
  /// default — a sniper kit might carry three magazines where a rifle carries
  /// five.
  quantity Int  @default(1)
  sortOrder Int @default(0) @map("sort_order")

  kit  Kit  @relation(fields: [kitId], references: [id], onDelete: Cascade)
  item Item @relation(fields: [itemId], references: [id], onDelete: Restrict)

  @@unique([kitId, itemId])
  @@index([kitId])
  @@map("kit_lines")
}

/// `טופס 1008` — one signing event covering everything a soldier received at
/// once: a weapon with its מסד alongside the magazines, sling and cleaning kit
/// that go with it.
///
/// The soldier's drawn signature is captured on the device at the counter and
/// stored here, so the form can be reproduced exactly as it was agreed to.
/// Every detail is snapshotted rather than joined: the form is evidence of
/// what was signed on a date, and must not change because a soldier later
/// moved company or an item was renamed.
model IssueForm {
  id          String   @id @default(uuid())
  /// Sequential, human-quotable form number. Printed on the PDF.
  formNo      Int      @unique @default(autoincrement()) @map("form_no")
  soldierId   String   @map("soldier_id")

  /// `פרטי החייל השואל` — the borrower, as they were when they signed.
  soldierNameSnapshot String  @map("soldier_name_snapshot")
  personalNumberSnapshot String? @map("personal_number_snapshot")
  companySnapshot     Company @map("company_snapshot")
  phoneSnapshot       String? @map("phone_snapshot")

  /// `מס קבלה` in the header box of the paper form.
  receiptNo      String?  @map("receipt_no")

  /// PNG data URL of the borrower's signature, drawn on the device.
  signatureImage String  @map("signature_image")
  signedAt       DateTime @default(now()) @map("signed_at")

  /// `פרטי החייל המשאיל` — the issuer. Their own signature is drawn too, so
  /// the printed form carries both halves the paper one has.
  issuedByUserId String  @map("issued_by_user_id")
  issuedByNameSnapshot String @map("issued_by_name_snapshot")
  issuerPersonalNumber String? @map("issuer_personal_number")
  issuerSignatureImage String? @map("issuer_signature_image")

  notes          String?

  soldier Soldier         @relation(fields: [soldierId], references: [id], onDelete: Restrict)
  issuedBy User           @relation(fields: [issuedByUserId], references: [id])
  lines   IssueFormLine[]

  @@index([soldierId])
  @@index([signedAt])
  @@map("issue_forms")
}

/// One line of a 1008: an item, how many, and its מסד when it has one.
model IssueFormLine {
  id          String  @id @default(uuid())
  issueFormId String  @map("issue_form_id")
  itemId      String  @map("item_id")
  /// Snapshotted for the same reason as the soldier's name.
  itemNameSnapshot String @map("item_name_snapshot")
  /// `מזהה` on the paper form: the weapon's serial, known as מסד or צ׳.
  serialSnapshot   String? @map("serial_snapshot")
  /// `י"ח` — the unit the quantity is counted in, as it was when signed.
  unitOfMeasure    String  @default("יח'") @map("unit_of_measure")
  quantity    Int     @default(1)
  /// `הערות` — the per-line note column the paper form has.
  lineNotes        String? @map("line_notes")
  /// The signature this line created, so a return can be traced back to the
  /// form it was issued on. Not a foreign key: an Excel import replaces every
  /// signature, and a signed form must outlive that.
  signatureId String? @map("signature_id")

  issueForm IssueForm @relation(fields: [issueFormId], references: [id], onDelete: Cascade)
  item      Item      @relation(fields: [itemId], references: [id])

  @@index([issueFormId])
  @@map("issue_form_lines")
}

// Append-only audit log. No update/delete route exists for this table.
model Movement {
  id                      String         @id @default(uuid())
  action                  MovementAction
  soldierId               String?        @map("soldier_id")
  soldierNameSnapshot     String         @map("soldier_name_snapshot")
  companySnapshot         Company?       @map("company_snapshot")
  itemId                  String?        @map("item_id")
  itemNameSnapshot        String         @map("item_name_snapshot")
  serialSnapshot          String?        @map("serial_snapshot")
  quantity                Int            @default(1)
  receiptNo               String?        @map("receipt_no")
  occurredAt              DateTime       @default(now()) @map("occurred_at")
  performedByUserId       String?        @map("performed_by_user_id")
  performedByNameSnapshot String         @map("performed_by_name_snapshot")
  notes                   String?
  // Loose reference, deliberately not a foreign key: the Excel import replaces all
  // signature rows, and append-only audit rows must never be rewritten to follow.
  signatureId             String?        @map("signature_id")

  soldier     Soldier?   @relation(fields: [soldierId], references: [id], onDelete: Restrict)
  item        Item?      @relation(fields: [itemId], references: [id], onDelete: Restrict)
  performedBy User?      @relation(fields: [performedByUserId], references: [id], onDelete: Restrict)

  @@index([occurredAt])
  @@index([action])
  @@index([soldierId])
  @@index([itemId])
  @@map("movements")
}

// ---------- manual inputs ----------

model Allocation {
  id        String  @id @default(uuid())
  itemId    String  @map("item_id")
  company   Company
  targetQty Int     @default(0) @map("target_qty")

  item Item @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([itemId, company])
  @@map("allocations")
}

model CountSession {
  id               String     @id @default(uuid())
  sessionDate      DateTime   @map("session_date") @db.Date
  shift            CountShift
  responsibleName  String?    @map("responsible_name")
  responsiblePn    String?    @map("responsible_pn")
  responsibleRank  String?    @map("responsible_rank")
  officerName      String?    @map("officer_name")
  officerPn        String?    @map("officer_pn")
  officerRank      String?    @map("officer_rank")
  recordedAt       DateTime   @default(now()) @map("recorded_at")
  recordedByUserId String     @map("recorded_by_user_id")
  isClosed         Boolean    @default(false) @map("is_closed")

  recordedBy User        @relation(fields: [recordedByUserId], references: [id])
  lines      CountLine[]

  @@unique([sessionDate, shift])
  @@map("count_sessions")
}

model CountLine {
  id             String @id @default(uuid())
  countSessionId String @map("count_session_id")
  itemId         String @map("item_id")
  countedQty     Int    @default(0) @map("counted_qty")
  faultyQty      Int    @default(0) @map("faulty_qty")
  notes          String?

  countSession CountSession @relation(fields: [countSessionId], references: [id], onDelete: Cascade)
  item         Item         @relation(fields: [itemId], references: [id])

  @@unique([countSessionId, itemId])
  @@map("count_lines")
}

model Attendance {
  id           String           @id @default(uuid())
  teamMemberId String           @map("team_member_id")
  date         DateTime         @db.Date
  status       AttendanceStatus
  note         String?

  teamMember TeamMember @relation(fields: [teamMemberId], references: [id], onDelete: Cascade)

  @@unique([teamMemberId, date])
  @@index([date])
  @@map("attendance")
}

/// One row per data problem found during an Excel import. Everything is imported;
/// these rows are what the "דרוש טיפול" tab lists so the gaps get fixed by hand.
model ImportIssue {
  id          String    @id @default(uuid())
  kind        IssueKind
  rowNumber   Int       @map("row_number")
  rawRow      String    @map("raw_row")
  detail      String
  signatureId String?   @map("signature_id")
  soldierId   String?   @map("soldier_id")
  itemId      String?   @map("item_id")
  serial      String?
  resolvedAt  DateTime? @map("resolved_at")
  importedAt  DateTime  @default(now()) @map("imported_at")

  @@index([kind])
  @@index([resolvedAt])
  @@map("import_issues")
}

/// Excel imports, kept out of `movements` so דוח תנועות contains only the two
/// real actions: giving an item to a soldier and taking it back.
model ImportLog {
  id            String   @id @default(uuid())
  occurredAt    DateTime @default(now()) @map("occurred_at")
  fileName      String?  @map("file_name")
  totalRows     Int      @map("total_rows")
  signatures    Int
  soldiers      Int
  flagged       Int
  issues        Int
  snapshotId    String?  @map("snapshot_id")
  performedByUserId   String? @map("performed_by_user_id")
  performedByNameSnapshot String @map("performed_by_name_snapshot")
  notes         String?

  performedBy User? @relation(fields: [performedByUserId], references: [id], onDelete: Restrict)

  @@index([occurredAt])
  @@map("import_logs")
}

model Snapshot {
  id              String       @id @default(uuid())
  createdAt       DateTime     @default(now()) @map("created_at")
  kind            SnapshotKind
  filePath        String       @map("file_path")
  sizeBytes       Int          @map("size_bytes")
  rowCount        Int          @default(0) @map("row_count")
  slackSentAt     DateTime?    @map("slack_sent_at")
  slackError      String?      @map("slack_error")
  createdByUserId String?      @map("created_by_user_id")

  createdBy User? @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@map("snapshots")
}
